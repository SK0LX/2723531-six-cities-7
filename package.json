{
  "name": "six-cities",
  "version": "4.0.0",
  "description": "Проект «Шесть городов» от HTML Academy",
  "keywords": [
    "rest",
    "api",
    "node.js"
  ],
  "main": "main.js",
  "scripts": {
    "start": "npm run build && node ./dist/main-rest.js",
    "cli": "npm run compile && node ./dist/main-cli.js",
    "build": "npm run clean && npm run compile",
    "lint": "eslint src/ --ext .ts",
    "compile": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "ts": "ts-node",
    "mock:server": "json-server ./mocks/mock-server-data.json --port 3123",
    "start:dev": "npm run build && node ./dist/main-rest.js | pino-pretty --colorize --translateTime SYS:standard"
  },
  "devDependencies": {
    "@types/convict": "^6.1.6",
    "@types/convict-format-with-validator": "^6.0.6",
    "@types/node": "18.16.3",
    "@typescript-eslint/eslint-plugin": "5.46.0",
    "@typescript-eslint/parser": "5.46.0",
    "eslint": "8.39.0",
    "eslint-config-htmlacademy": "9.1.1",
    "json-server": "1.0.0-beta.15",
    "pino-pretty": "^13.2.0",
    "rimraf": "3.0.2",
    "ts-node": "10.9.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=8"
  },
  "dependencies": {
    "@typegoose/typegoose": "^13.5.0",
    "chalk": "5.6.2",
    "convict": "^6.2.5",
    "convict-format-with-validator": "^6.2.0",
    "dotenv": "^18.0.7",
    "got": "16.0.0",
    "inversify": "^8.2.3",
    "mongoose": "~9.9.5",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.8.1"
  }
}
